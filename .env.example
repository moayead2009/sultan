# Application/database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/solutions_gate
AUTH_SECRET=replace-with-a-long-random-secret
APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# Content/runtime
USE_DATABASE_CONTENT=false
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=public/uploads
MAX_UPLOAD_BYTES=10485760

# S3-compatible production media storage. Never commit real credentials.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_PUBLIC_URL=

# Inquiry email. The implemented external provider is Resend; use none when disabled.
MAIL_PROVIDER=none
MAIL_FROM=
RESEND_API_KEY=

# Reserved SMTP fields are not used by the current application runtime.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Optional anti-bot protection. Configure both values together.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

RATE_LIMIT_WINDOW_SECONDS=600
RATE_LIMIT_MAX=5

# Optional provider-specific error-monitoring DSN. Keep it outside source control.
ERROR_MONITORING_DSN=

# Production requirements are verified by `npm run ops:preflight`:
# - APP_URL and NEXTAUTH_URL are explicit HTTPS URLs on the same origin.
# - AUTH_SECRET is a non-placeholder secret.
# - STORAGE_DRIVER=s3 with a bucket and HTTPS public URL.
# - object-storage credentials, Turnstile values, and Resend values are paired when enabled.
# OWNER_NAME / OWNER_EMAIL / OWNER_PASSWORD are one-time bootstrap inputs only.
# Do not store OWNER_PASSWORD in a long-lived production env file.
